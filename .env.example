# =========================================================================
# CONFIGURACIÓN LOCAL - CONTROL DE INVENTARIOS CON BIGQUERY
# =========================================================================
# Copia este archivo como '.env' en la raíz del proyecto para desarrollo local.

# 1. Configuración de Google Cloud
# Reemplaza con tu ID de proyecto de Google Cloud real si es diferente
GOOGLE_CLOUD_PROJECT=project-c0f821cf-8af2-411b-811

# Ruta al archivo JSON con las credenciales de tu Cuenta de Servicio.
# Genera esta llave desde la consola de GCP -> IAM & Administrador -> Cuentas de Servicio.
# Coloca el archivo JSON en la raíz del proyecto (ej. service_account.json)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# 2. Configuración del Conjunto de Datos y Tabla de BigQuery
BIGQUERY_DATASET=Proyecto_IOT
BIGQUERY_TABLE=control_inventarios

# 3. Configuración del Servidor Flask (Desarrollo Local)
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=8080
